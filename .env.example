# API keys for local probing (copy to .env, which is gitignored and never committed).
# Whichever key you have, that gateway gets tested; gateways missing a key are skipped automatically.
SYNTHORAI_API_KEY=
OPENROUTER_API_KEY=
AIHUBMIX_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
SILICONFLOW_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
OHMYGPT_API_KEY=
CLOSEAI_API_KEY=
# Probe region label (tag it with wherever this machine is, e.g. local-cn / local-hk)
PROBE_REGION=local
